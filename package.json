{
	"name": "congeegator",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --mode development",
		"build:staging": "vite build --mode staging",
		"build:dev": "vite build --mode development",
		"build:prod": "vite build --mode production",
		"generate-pwa-assets": "pwa-assets-generator && mv src/lib/assets/pwa-* static",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"r2-cleanup:staging": "rclone delete r2-congeegator:congeegator-dev/data/v1/ --min-age 90d --fast-list --stats-one-line",
		"r2-cleanup:prod": "rclone delete r2-congeegator:congeegator/data/v1/ --min-age 90d --fast-list --stats-one-line",
		"r2-upload:staging": "rclone copy r2_data r2-congeegator:congeegator-dev --transfers=64 --checkers=64 --fast-list --stats-one-line --checksum",
		"r2-upload:prod": "rclone copy r2_data r2-congeegator:congeegator --transfers=64 --checkers=64 --fast-list --stats-one-line --checksum",
		"deploy:staging": "pixi run python data_processing.py && npm run r2-upload:staging && npm run build:staging && npx wrangler deploy --env=staging",
		"deploy:prod": "pixi run python data_processing.py && npm run r2-upload:prod && npm run build:prod && npx wrangler deploy --env=production",
		"wrangler-dev": "npm run build && npx wrangler dev --remote",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.21.0",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@sveltejs/adapter-cloudflare": "^7.2.5",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^24",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"dexie": "^4.2.1"
	}
}
